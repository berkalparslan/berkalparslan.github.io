// Cloudflare (bamstudio.dev) yayını: reponun kendisi statik site olarak yüklenir.
// GitHub Pages (berkalparslan.github.io) aynı repodan yayınlanmaya devam eder.
{
  "name": "bamstudio",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "bamstudio.dev", "custom_domain": true },
    { "pattern": "www.bamstudio.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
